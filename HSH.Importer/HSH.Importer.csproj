    <ServerGarbageCollection>true</ServerGarbageCollection>
    <UserSecretsId>f4564e43-680f-47ad-967d-446a44f78cbe</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HSH.Data\HSH.Data.csproj" />
